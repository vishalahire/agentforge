{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentforge.dev/schemas/manifest.schema.json",
  "title": "AgentForge Manifest",
  "description": "Schema for .agentforge/manifest.yaml",
  "type": "object",
  "required": [
    "schema_version",
    "project"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "properties": {
        "readme": {
          "type": "string"
        },
        "agent_instructions": {
          "type": "string"
        },
        "documentation": {
          "type": "object",
          "properties": {
            "architecture": {
              "type": "string"
            },
            "decisions": {
              "type": "string"
            },
            "research": {
              "type": "string"
            },
            "evaluations": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "progressive",
            "explicit"
          ]
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "portability": {
      "type": "object",
      "properties": {
        "vendor_neutral": {
          "type": "boolean"
        },
        "adapters": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "experimental",
            "active",
            "stable",
            "deprecated"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}